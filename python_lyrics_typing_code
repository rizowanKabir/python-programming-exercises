import sys
import time
import random
import os

# Neon Colors
PINK = "\033[38;5;213m"
PURPLE = "\033[38;5;141m"
BLUE = "\033[38;5;117m"
CYAN = "\033[38;5;159m"
WHITE = "\033[97m"
BOLD = "\033[1m"
RESET = "\033[0m"

COLORS = [PINK, PURPLE, BLUE, CYAN, WHITE]


def typing_effect(text, speed=0.065):
    color = random.choice(COLORS)

    for char in text:
        sys.stdout.write(f"{BOLD}{color}{char}{RESET}")
        sys.stdout.flush()

        time.sleep(max(0.005, speed + random.uniform(-0.015, 0.02)))

    print()


